{
  "name": "skill-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "Train a Cursor agent skill against a folder and a task. Edits stick only when a fresh held-out run scores higher.",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "docs:dev": "npm --prefix docs run dev",
    "docs:check": "npm --prefix docs run check",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "docs:screenshots": "npm --prefix docs run screenshots",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^39.0.0",
    "electron-vite": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
