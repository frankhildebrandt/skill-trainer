---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Seite nicht gefunden">
  <main id="main" class="not-found wrap">
    <p class="eyebrow">404 · Seite nicht gefunden</p>
    <h1>Hier geht’s<br />nicht weiter.</h1>
    <p>Vielleicht wurde die Seite verschoben. In der Dokumentation findest du den passenden Einstieg.</p>
    <a class="button" href="/docs/">Zur Dokumentation <span aria-hidden="true">→</span></a>
  </main>
</BaseLayout>
